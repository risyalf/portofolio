---
import { Github, Sun, Moon } from 'lucide-react';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="fixed top-0 inset-x-0 z-50 px-4 py-4 pointer-events-none">
  <div class="max-w-5xl mx-auto flex items-center justify-between pointer-events-auto">
    <!-- Brand -->
    <a
      href="/"
      class="group flex items-center gap-2.5 px-3.5 py-2 rounded-full bg-[hsl(var(--bg-elevated))]/85 backdrop-blur-md border border-[hsl(var(--border))] hover:border-[hsl(var(--accent))/0.5] transition-all shadow-sm"
      aria-label="Risyal Febrianto Home"
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="font-display font-bold text-sm tracking-tight text-[hsl(var(--fg))]">
        risyal<span class="text-[hsl(var(--accent))]">.dev</span>
      </span>
    </a>

    <!-- Navigation Bar -->
    <nav class="flex items-center gap-1 sm:gap-2 px-2.5 py-1.5 rounded-full bg-[hsl(var(--bg-elevated))]/85 backdrop-blur-md border border-[hsl(var(--border))] text-sm shadow-sm font-medium">
      <a
        href="/"
        class="px-3 py-1 rounded-full transition-all text-xs sm:text-sm font-display text-[hsl(var(--fg))] bg-[hsl(var(--bg-hover))] font-semibold border border-[hsl(var(--border))]"
      >
        Home
      </a>

      <a
        href="/#about"
        class="px-3 py-1 rounded-full text-xs sm:text-sm text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all font-display"
      >
        About
      </a>

      <a
        href="/#experience"
        class="px-3 py-1 rounded-full text-xs sm:text-sm text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all font-display"
      >
        Experience
      </a>

      <a
        href="/#projects"
        class="px-3 py-1 rounded-full text-xs sm:text-sm text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all font-display"
      >
        Projects
      </a>

      <a
        href="/#blog"
        class="px-3 py-1 rounded-full text-xs sm:text-sm text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all font-display flex items-center gap-1.5"
      >
        <span>Blog</span>
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
      </a>

      <span class="w-[1px] h-4 bg-[hsl(var(--border))] mx-1" aria-hidden="true"></span>

      <!-- Theme Toggle -->
      <button
        id="navbar-theme-toggle"
        class="p-1.5 rounded-full text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--accent))] hover:bg-[hsl(var(--bg-hover))] transition-all"
        aria-label="Toggle theme"
        type="button"
      >
        <Sun className="h-4 w-4 hidden [html.light_&]:block text-amber-500" />
        <Moon className="h-4 w-4 block [html.light_&]:hidden text-[hsl(var(--fg-muted))]" />
      </button>

      <!-- GitHub -->
      <a
        href="https://github.com/risyalf"
        target="_blank"
        rel="noopener noreferrer"
        class="p-1.5 rounded-full text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all"
        aria-label="GitHub profile"
      >
        <Github className="h-4 w-4" />
      </a>
    </nav>
  </div>
</header>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById('navbar-theme-toggle');
    if (!toggle) return;

    const newToggle = toggle.cloneNode(true) as HTMLElement;
    toggle.parentNode?.replaceChild(newToggle, toggle);

    newToggle.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });
  }

  if (typeof localStorage !== 'undefined') {
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'light' || (!savedTheme && !prefersDark)) {
      document.documentElement.classList.add('light');
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.classList.remove('light');
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
