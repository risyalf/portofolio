---
import { Github, Sun, Moon, BookOpen } from 'lucide-react';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const isBlog = currentPath.startsWith('/blog');
---

<header class="fixed top-0 inset-x-0 z-50 px-4 py-3 pointer-events-none">
  <div class="max-w-4xl mx-auto flex items-center justify-between pointer-events-auto">
    <!-- Brand / Root -->
    <a
      href="/"
      class="group flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[hsl(var(--bg-elevated))]/90 backdrop-blur-md border border-[hsl(var(--border))] hover:border-[hsl(var(--accent))] transition-all text-sm font-mono text-[hsl(var(--fg))] shadow-sm"
      aria-label="Home"
    >
      <span class="inline-block w-2 h-2 rounded-full bg-[hsl(var(--accent))] animate-pulse"></span>
      <span class="text-[hsl(var(--fg-muted))] group-hover:text-[hsl(var(--fg))] transition-colors">~/</span>
      <span class="font-medium text-[hsl(var(--fg))]">risyal</span>
    </a>

    <!-- Nav Items + Theme Toggle -->
    <nav class="flex items-center gap-1 sm:gap-2 px-2 sm:px-3 py-1.5 rounded-full bg-[hsl(var(--bg-elevated))]/90 backdrop-blur-md border border-[hsl(var(--border))] text-sm font-mono shadow-sm">
      <a
        href="/"
        class:list={[
          "px-2.5 py-1 rounded-full transition-all text-xs sm:text-sm",
          !isBlog
            ? "text-[hsl(var(--fg))] bg-[hsl(var(--bg-hover))] font-medium border border-[hsl(var(--border))]"
            : "text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))]"
        ]}
      >
        Home
      </a>

      <a
        href="/#about"
        class="hidden sm:inline-block px-2.5 py-1 rounded-full text-xs sm:text-sm text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all"
      >
        About
      </a>

      <a
        href="/#projects"
        class="hidden sm:inline-block px-2.5 py-1 rounded-full text-xs sm:text-sm text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all"
      >
        Projects
      </a>

      <a
        href="/blog"
        class:list={[
          "flex items-center gap-1.5 px-2.5 py-1 rounded-full transition-all text-xs sm:text-sm",
          isBlog
            ? "text-[hsl(var(--accent))] bg-[hsl(var(--bg-hover))] font-medium border border-[hsl(var(--accent))/0.3]"
            : "text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))]"
        ]}
      >
        <BookOpen className="w-3.5 h-3.5 inline-block text-[hsl(var(--accent))]" />
        <span>Blog</span>
        <span class="inline-block px-1.5 py-0.2 text-[10px] uppercase font-mono rounded bg-[hsl(var(--accent))/0.15] text-[hsl(var(--accent))] border border-[hsl(var(--accent))/0.3]">
          auto
        </span>
      </a>

      <span class="w-[1px] h-4 bg-[hsl(var(--border))] mx-1" aria-hidden="true"></span>

      <!-- Theme Toggle -->
      <button
        id="navbar-theme-toggle"
        class="p-1.5 rounded-full text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--accent))] hover:bg-[hsl(var(--bg-hover))] transition-all"
        aria-label="Toggle theme"
        type="button"
      >
        <Sun className="h-4 w-4 hidden [html.light_&]:block text-amber-500" />
        <Moon className="h-4 w-4 block [html.light_&]:hidden text-[hsl(var(--fg-muted))]" />
      </button>

      <!-- GitHub -->
      <a
        href="https://github.com/risyalf"
        target="_blank"
        rel="noopener noreferrer"
        class="p-1.5 rounded-full text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--fg))] hover:bg-[hsl(var(--bg-hover))] transition-all"
        aria-label="GitHub profile"
      >
        <Github className="h-4 w-4" />
      </a>
    </nav>
  </div>
</header>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById('navbar-theme-toggle');
    if (!toggle) return;

    // Remove any previously attached click listeners by cloning
    const newToggle = toggle.cloneNode(true) as HTMLElement;
    toggle.parentNode?.replaceChild(newToggle, toggle);

    newToggle.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      if (isLight) {
        document.documentElement.removeAttribute('data-theme');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });
  }

  // Initialize theme from storage
  if (typeof localStorage !== 'undefined') {
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'light' || (!savedTheme && !prefersDark)) {
      document.documentElement.classList.add('light');
      document.documentElement.removeAttribute('data-theme');
    } else {
      document.documentElement.classList.remove('light');
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
