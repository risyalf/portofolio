---
import { BookOpen, Sparkles, Clock, Mail, Wrench } from 'lucide-react';

const upcomingArticles = [
  {
    title: "High-Volume Inventory Sync: Managing Redis Horizon Queues in Enterprise WMS",
    summary: "Real-world strategies for processing thousands of asynchronous stock transactions with idempotency, exponential backoff, and zero event loss.",
    tags: ["Laravel 11", "Redis Horizon", "WMS", "Queues"],
    status: "Drafting",
    progress: "75%",
    statusColor: "text-amber-400 bg-amber-400/10 border-amber-400/20",
  },
  {
    title: "PostgreSQL Query Optimization: Eliminating Deadlocks in High-Concurrency Systems",
    summary: "Case study on diagnosing query lock contention, analyzing EXPLAIN ANALYZE traces, and restructuring relational indexes in production.",
    tags: ["PostgreSQL", "Database Tuning", "SQL", "High Concurrency"],
    status: "Reviewing",
    progress: "90%",
    statusColor: "text-emerald-400 bg-emerald-400/10 border-emerald-400/20",
  },
  {
    title: "Architecting Clean Service-Repository Boundaries in Modern Laravel 11",
    summary: "Decoupling business logic from framework layers without over-engineering. Practical patterns for testable, maintainable enterprise backends.",
    tags: ["Architecture", "PHP 8.3", "Clean Code", "Design Patterns"],
    status: "In Outline",
    progress: "40%",
    statusColor: "text-[hsl(var(--accent))] bg-[hsl(var(--accent))/0.1] border-[hsl(var(--accent))/0.25]",
  },
];
---

<section id="blog" class="section-gap bg-[hsl(var(--bg-elevated))]/40 border-y border-[hsl(var(--border))]" aria-labelledby="blog-heading">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
      <div class="max-w-2xl">
        <div class="tag-pill mb-3">
          <BookOpen class="w-3.5 h-3.5" />
          <span>Technical Writing & Insights</span>
        </div>
        <h2 id="blog-heading" class="text-display text-2xl sm:text-4xl text-[hsl(var(--fg))]">
          Laravel & PHP Engineering Lab
        </h2>
        <p class="text-body text-[hsl(var(--fg-muted))] mt-3 text-base sm:text-lg">
          I am currently distilling hands-on production experiences into deep-dive technical articles. No generic tutorials or artificial fluff — only battle-tested code and architecture notes.
        </p>
      </div>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[hsl(var(--bg))] border border-[hsl(var(--border))] text-xs font-mono text-[hsl(var(--fg-muted))] self-start md:self-auto">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
        </span>
        <span>Editorial Status: <strong>Brewing in Lab</strong></span>
      </div>
    </div>

    <!-- Creative In-the-Lab / Upcoming Pipeline -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {upcomingArticles.map((article) => (
        <article class="card-base p-6 sm:p-7 flex flex-col justify-between hover:border-[hsl(var(--accent)/0.6)] transition-all">
          <div class="space-y-4">
            
            <!-- Status & Progress -->
            <div class="flex items-center justify-between text-xs font-mono">
              <span class={`px-2.5 py-0.5 rounded-full border font-semibold ${article.statusColor}`}>
                {article.status}
              </span>
              <span class="text-[hsl(var(--fg-muted))] flex items-center gap-1">
                <Clock class="w-3 h-3 text-[hsl(var(--accent))]" />
                <span>{article.progress} Complete</span>
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-display font-bold text-lg text-[hsl(var(--fg))] leading-snug">
              {article.title}
            </h3>

            <!-- Description -->
            <p class="text-body text-xs sm:text-sm text-[hsl(var(--fg-muted))] leading-relaxed">
              {article.summary}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 pt-2">
              {article.tags.map((tag) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[hsl(var(--bg))] text-[hsl(var(--fg-muted))] border border-[hsl(var(--border))]">
                  #{tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Card Footer State -->
          <div class="pt-5 mt-6 border-t border-[hsl(var(--border))] flex items-center justify-between text-xs text-[hsl(var(--fg-muted))] font-mono">
            <span class="flex items-center gap-1.5">
              <Wrench class="w-3.5 h-3.5 text-amber-400" />
              <span>Coming to Production</span>
            </span>
            <span class="text-[hsl(var(--accent))]">
              Stay Tuned ↗
            </span>
          </div>
        </article>
      ))}
    </div>

    <!-- Creative Notice & Topic Suggestion Banner -->
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-[hsl(var(--bg-elevated))] border border-[hsl(var(--border))] flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 text-center md:text-left">
        <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-emerald-400">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Real-World Engineering Notes Ahead</span>
        </div>
        <h4 class="font-display font-bold text-base sm:text-lg text-[hsl(var(--fg))]">
          Have a specific Laravel or Backend challenge you'd like to explore?
        </h4>
        <p class="text-xs sm:text-sm text-[hsl(var(--fg-muted))] max-w-xl">
          I regularly exchange ideas with fellow engineers and recruiters. Drop me a note with topic suggestions or discuss architecture challenges.
        </p>
      </div>

      <a
        href="mailto:risyalfebrianto97@gmail.com?subject=Topic%20Suggestion%20/%20Laravel%20Engineering"
        class="btn-primary text-xs sm:text-sm whitespace-nowrap shrink-0"
      >
        <Mail class="w-4 h-4 mr-2" />
        <span>Suggest a Topic / Connect</span>
      </a>
    </div>

  </div>
</section>
