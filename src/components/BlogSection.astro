---
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Calendar, Clock, Terminal } from 'lucide-react';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<section id="blog" class="section-gap bg-[hsl(var(--bg-elevated))]" aria-labelledby="blog-heading">
  <div class="container-wide">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[hsl(var(--bg))] border border-[hsl(var(--border))] text-xs font-mono text-[hsl(var(--accent))]">
          <Terminal className="w-3.5 h-3.5" />
          <span>~/articles</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        </div>
        <h2 id="blog-heading" class="text-heading text-heading-xl text-[hsl(var(--fg))]">
          Laravel Tech Articles
        </h2>
        <p class="text-small text-[hsl(var(--fg-muted))] max-w-xl">
          Eksplorasi arsitektur, optimasi performa backend, antrean, dan sistem real-time modern. Ditulis otomatis setiap hari pukul 21:00 WIB.
        </p>
      </div>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-xs font-mono font-medium text-[hsl(var(--accent))] hover:underline self-start sm:self-auto"
      >
        <span>Lihat Semua Artikel ({allPosts.length})</span>
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestPosts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });

        return (
          <article class="card-base group relative p-6 bg-[hsl(var(--bg))] border border-[hsl(var(--border))] hover:border-[hsl(var(--accent))] flex flex-col justify-between transition-all duration-200 hover:-translate-y-1">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-[hsl(var(--fg-muted))]">
                <span class="px-2 py-0.5 rounded bg-[hsl(var(--accent))/0.15] text-[hsl(var(--accent))] border border-[hsl(var(--accent))/0.3]">
                  {post.data.category}
                </span>
                <span class="flex items-center gap-1">
                  <Clock className="w-3 h-3" />
                  {post.data.readTime}
                </span>
              </div>

              <h3 class="text-base font-mono font-bold text-[hsl(var(--fg))] group-hover:text-[hsl(var(--accent))] transition-colors line-clamp-2">
                <a href={`/blog/${post.slug}`} class="focus:outline-none">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  {post.data.title}
                </a>
              </h3>

              <p class="text-xs text-[hsl(var(--fg-muted))] line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-[hsl(var(--border))] flex items-center justify-between text-xs font-mono text-[hsl(var(--fg-muted))]">
              <span class="flex items-center gap-1">
                <Calendar className="w-3 h-3" />
                {formattedDate}
              </span>
              <span class="text-[hsl(var(--accent))] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Baca <ArrowRight className="w-3 h-3" />
              </span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
