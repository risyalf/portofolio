---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '@/components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "Risyal Febrianto - Full-Stack Developer Portfolio & Laravel Tech Blog",
  ogImage = "/risyal.jpeg"
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="Risyal Febrianto" />
    <meta name="keywords" content="Full-Stack Developer, Web Developer, Laravel, React, Node.js, PHP, TypeScript" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="font-ui antialiased min-h-screen bg-[hsl(var(--bg))] text-[hsl(var(--fg))]">
    <Navbar />
    <slot />
  </body>
</html>