---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '@/components/Navbar.astro';
import { config } from '@/data/config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    category?: string;
    tags?: string[];
    author?: string;
    readTime?: string;
  };
  breadcrumbs?: Array<{
    name: string;
    item: string;
  }>;
  canonicalURL?: string;
  noindex?: boolean;
}

const {
  title,
  description = config.description,
  ogImage = '/risyal.jpeg',
  article,
  breadcrumbs,
  canonicalURL,
  noindex = false,
} = Astro.props;

// Compute canonical and absolute URLs
const siteBaseUrl = Astro.site?.toString().replace(/\/$/, '') || config.siteUrl;
const currentUrl = canonicalURL || new URL(Astro.url.pathname, siteBaseUrl).toString();
const absoluteOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, siteBaseUrl).toString();

// Generate JSON-LD Schema.org graph
const schemaGraph: any[] = [
  {
    '@type': 'Person',
    '@id': `${siteBaseUrl}/#person`,
    name: config.author,
    jobTitle: config.jobTitle,
    url: siteBaseUrl,
    image: new URL('/risyal.jpeg', siteBaseUrl).toString(),
    sameAs: [config.social.github, config.social.linkedin],
    description: config.description,
    knowsAbout: [
      'Laravel',
      'PHP 8.3',
      'High-Throughput Backend',
      'Redis & Horizon',
      'React',
      'TypeScript',
      'PostgreSQL',
      'MySQL',
      'System Architecture',
      'Database Optimization',
      'Docker',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': `${siteBaseUrl}/#website`,
    url: siteBaseUrl,
    name: config.siteTitle,
    description: config.description,
    inLanguage: ['id-ID', 'en-US'],
    publisher: {
      '@id': `${siteBaseUrl}/#person`,
    },
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  schemaGraph.push({
    '@type': 'BreadcrumbList',
    '@id': `${currentUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: crumb.name,
      item: crumb.item.startsWith('http') ? crumb.item : new URL(crumb.item, siteBaseUrl).toString(),
    })),
  });
}

if (article) {
  schemaGraph.push({
    '@type': 'TechArticle',
    '@id': `${currentUrl}#article`,
    isPartOf: {
      '@id': `${siteBaseUrl}/#website`,
    },
    headline: title,
    description: description,
    url: currentUrl,
    inLanguage: 'id-ID',
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': currentUrl,
    },
    datePublished: article.publishedTime,
    dateModified: article.modifiedTime || article.publishedTime,
    author: {
      '@type': 'Person',
      name: article.author || config.author,
      url: siteBaseUrl,
    },
    publisher: {
      '@id': `${siteBaseUrl}/#person`,
    },
    image: absoluteOgImage,
    articleSection: article.category || 'Backend Engineering',
    keywords: article.tags?.join(', ') || config.keywords,
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
};
---

<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={article?.author || config.author} />
    <meta name="keywords" content={article?.tags?.join(', ') || config.keywords} />
    <link rel="canonical" href={currentUrl} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta
      name="googlebot"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#080808" />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${config.author} — Catatan Arsitektur & Rekayasa Perangkat Lunak`}
      href="/rss.xml"
    />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content={config.siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />

    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        <meta property="article:author" content={article.author || config.author} />
        {article.category && <meta property="article:section" content={article.category} />}
        {article.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@risyalf" />

    <!-- Schema.org Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />
  </head>
  <body class="font-ui antialiased min-h-screen bg-[hsl(var(--bg))] text-[hsl(var(--fg))]">
    <Navbar />
    <slot />
  </body>
</html>
