---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/Footer';
import { projects, type Project } from '@/data/portfolioData';
import { config } from '@/data/config';
import {
  ArrowLeft,
  ExternalLink,
  Github,
  CheckCircle2,
  Calendar,
  UserCheck,
  Layers,
  ChevronRight,
  ShieldCheck,
} from 'lucide-react';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const pageTitle = `${project.title} — Portfolio Case Study | ${config.author}`;
const pageDesc = project.summary;
---

<Layout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Projects', item: '/#projects' },
    { name: project.title, item: `/projects/${project.slug}/` },
  ]}
>
  <main class="min-h-screen pt-28 pb-20">
    <div class="container-wide">
      {/* Back Button */}
      <div class="mb-8">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 text-sm text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--accent))] transition-colors font-medium group"
        >
          <ArrowLeft className="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          <span>Kembali ke Portofolio Utama</span>
        </a>
      </div>

      {/* Header Case Study */}
      <header class="max-w-4xl space-y-6 mb-12">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="tag-pill text-xs">
            <Layers className="w-3.5 h-3.5" />
            <span>Case Study</span>
          </span>
          {project.timeline && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-[hsl(var(--bg-elevated))] text-[hsl(var(--fg-muted))] border border-[hsl(var(--border))]">
              <Calendar className="w-3.5 h-3.5" />
              <span>{project.timeline}</span>
            </span>
          )}
          {project.role && (
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-[hsl(var(--bg-elevated))] text-[hsl(var(--accent))] border border-[hsl(var(--accent)/0.3)]">
              <UserCheck className="w-3.5 h-3.5" />
              <span>{project.role}</span>
            </span>
          )}
        </div>

        <h1 class="text-display text-3xl sm:text-5xl text-[hsl(var(--fg))] font-extrabold tracking-tight leading-tight">
          {project.title}
        </h1>

        <p class="text-body text-base sm:text-xl text-[hsl(var(--fg-muted))] leading-relaxed">
          {project.overview || project.summary}
        </p>

        {/* Action Buttons */}
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center gap-2 text-sm px-5 py-2.5 rounded-lg shadow-md font-medium"
            >
              <span>{project.link.includes('github.com') ? 'Lihat Source Code Demo' : 'Kunjungi Live Website'}</span>
              <ExternalLink className="w-4 h-4" />
            </a>
          )}
          {project.externalLink && !project.link.includes('github.com') && (
            <a
              href={project.externalLink.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary inline-flex items-center gap-2 text-sm px-5 py-2.5 rounded-lg border border-[hsl(var(--border))] font-medium"
            >
              <Github className="w-4 h-4" />
              <span>{project.externalLink.title}</span>
            </a>
          )}
        </div>
      </header>

      {/* Main Showcase Hero Image */}
      {project.images && project.images.length > 0 && (
        <div class="mb-14 rounded-2xl overflow-hidden border border-[hsl(var(--border))] bg-[hsl(var(--bg-elevated))] shadow-xl">
          <img
            src={project.images[0]}
            alt={`${project.title} Primary View`}
            class="w-full aspect-[16/10] sm:aspect-video object-cover object-top"
            loading="eager"
            decoding="async"
          />
        </div>
      )}

      {/* Grid Content: Details, Architecture, Impact */}
      <div class="grid lg:grid-cols-12 gap-10">
        
        {/* Left Column (8 cols): Deep Dive Content */}
        <div class="lg:col-span-8 space-y-12">
          
          {/* Challenge & Problem Statement */}
          <section class="card-base p-6 sm:p-8 space-y-4">
            <div class="flex items-center gap-2 text-[hsl(var(--accent))]">
              <span class="w-2 h-2 rounded-full bg-[hsl(var(--accent))]"></span>
              <h2 class="font-display font-bold text-lg sm:text-xl uppercase tracking-wider text-[hsl(var(--fg))]">
                Tantangan & Latar Belakang (The Challenge)
              </h2>
            </div>
            <p class="text-[hsl(var(--fg-muted))] text-sm sm:text-base leading-relaxed">
              {project.details.challenge}
            </p>
          </section>

          {/* Engineering Solution */}
          <section class="card-base p-6 sm:p-8 space-y-4">
            <div class="flex items-center gap-2 text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <h2 class="font-display font-bold text-lg sm:text-xl uppercase tracking-wider text-[hsl(var(--fg))]">
                Solusi & Rekayasa Sistem (Engineering Solution)
              </h2>
            </div>
            <p class="text-[hsl(var(--fg-muted))] text-sm sm:text-base leading-relaxed">
              {project.details.solution}
            </p>
          </section>

          {/* Architecture Highlights (If Available) */}
          {project.architectureHighlights && project.architectureHighlights.length > 0 && (
            <section class="space-y-6">
              <h2 class="font-display font-bold text-2xl text-[hsl(var(--fg))]">
                Sorotan Arsitektur & Implementasi Teknis
              </h2>
              <div class="grid sm:grid-cols-2 gap-4">
                {project.architectureHighlights.map((item) => (
                  <div class="p-5 rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--bg-elevated))] space-y-2">
                    <h3 class="font-display font-semibold text-base text-[hsl(var(--accent))] flex items-center gap-2">
                      <ShieldCheck className="w-4 h-4 shrink-0" />
                      <span>{item.title}</span>
                    </h3>
                    <p class="text-xs sm:text-sm text-[hsl(var(--fg-muted))] leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* Full Gallery Showcase */}
          {project.images && project.images.length > 1 && (
            <section class="space-y-6">
              <h2 class="font-display font-bold text-2xl text-[hsl(var(--fg))]">
                Galeri Antarmuka & Tangkapan Layar Sistem
              </h2>
              <div class="space-y-6">
                {project.images.slice(1).map((imgUrl, idx) => (
                  <div class="rounded-xl overflow-hidden border border-[hsl(var(--border))] bg-[hsl(var(--bg-elevated))] group shadow-md">
                    <div class="p-3 border-b border-[hsl(var(--border))] flex items-center justify-between text-xs text-[hsl(var(--fg-muted))] font-mono">
                      <span>Screen Preview #{idx + 2}</span>
                      <span class="text-[hsl(var(--accent))]">High Resolution</span>
                    </div>
                    <img
                      src={imgUrl}
                      alt={`${project.title} Interface Preview ${idx + 2}`}
                      class="w-full object-cover object-top hover:scale-[1.01] transition-transform duration-300"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>

        {/* Right Sidebar (4 cols): Meta, Tech Stack, Impact */}
        <aside class="lg:col-span-4 space-y-8">
          
          {/* Measurable Impact */}
          <div class="card-base p-6 space-y-4">
            <h3 class="font-display font-bold text-base uppercase tracking-wider text-[hsl(var(--fg))]">
              Dampak Terukur (Business Impact)
            </h3>
            <ul class="space-y-3">
              {project.details.impact.map((impactItem) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm text-[hsl(var(--fg-muted))]">
                  <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                  <span class="leading-relaxed">{impactItem}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Tech Stack Tags */}
          <div class="card-base p-6 space-y-4">
            <h3 class="font-display font-bold text-base uppercase tracking-wider text-[hsl(var(--fg))]">
              Teknologi & Modul Utama
            </h3>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="tag-mono text-xs">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          {/* Navigation to Other Projects */}
          <div class="card-base p-6 space-y-4">
            <h3 class="font-display font-bold text-base uppercase tracking-wider text-[hsl(var(--fg))]">
              Eksplorasi Proyek Lainnya
            </h3>
            <div class="space-y-2">
              {projects
                .filter((p) => p.slug !== project.slug)
                .map((other) => (
                  <a
                    href={`/projects/${other.slug}/`}
                    class="p-3 rounded-lg border border-[hsl(var(--border))] hover:border-[hsl(var(--accent)/0.5)] hover:bg-[hsl(var(--bg-hover))] transition-all flex items-center justify-between text-xs sm:text-sm font-medium group"
                  >
                    <span class="text-[hsl(var(--fg))] group-hover:text-[hsl(var(--accent))] truncate max-w-[200px]">
                      {other.title}
                    </span>
                    <ChevronRight className="w-4 h-4 text-[hsl(var(--fg-muted))] group-hover:text-[hsl(var(--accent))] shrink-0" />
                  </a>
                ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
