---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/Footer';
import { getCollection, type CollectionEntry } from 'astro:content';
import {
  ArrowLeft,
  ArrowRight,
  Calendar,
  Clock,
  User,
  Sparkles,
  Copy,
  Share2,
} from 'lucide-react';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );

  return sorted.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index < sorted.length - 1 ? sorted[index + 1] : null,
      nextPost: index > 0 ? sorted[index - 1] : null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title={`${post.data.title} — Risyal Febrianto`}
  description={post.data.description}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    category: post.data.category,
    tags: post.data.tags,
    author: post.data.author,
    readTime: post.data.readTime,
  }}
  breadcrumbs={[
    { name: 'Beranda', item: '/' },
    { name: 'Blog', item: '/blog' },
    { name: post.data.title, item: `/blog/${post.slug}` },
  ]}
>
  <main class="min-h-screen pt-28 pb-20 px-4">
    <div class="max-w-3xl mx-auto space-y-10">
      <!-- Semantic Breadcrumbs & Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center justify-between text-xs font-mono text-[hsl(var(--fg-muted))] border-b border-[hsl(var(--border))] pb-4">
        <ol class="flex items-center gap-1.5 flex-wrap">
          <li>
            <a href="/" class="hover:text-[hsl(var(--accent))] transition-colors">Home</a>
          </li>
          <li class="text-[hsl(var(--fg-subtle))]">/</li>
          <li>
            <a href="/blog" class="hover:text-[hsl(var(--accent))] transition-colors">Blog</a>
          </li>
          <li class="text-[hsl(var(--fg-subtle))]">/</li>
          <li class="text-[hsl(var(--accent))] truncate max-w-[180px] sm:max-w-[280px]" aria-current="page">
            {post.slug}
          </li>
        </ol>

        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[hsl(var(--border))] bg-[hsl(var(--bg-elevated))] hover:border-[hsl(var(--accent))] hover:text-[hsl(var(--accent))] transition-all text-xs shrink-0"
        >
          <ArrowLeft className="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Semua Artikel</span>
          <span class="sm:hidden">Kembali</span>
        </a>
      </nav>

      <!-- Post Header -->
      <header class="space-y-6">
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
          <span class="px-2.5 py-1 rounded bg-[hsl(var(--accent))/0.15] text-[hsl(var(--accent))] border border-[hsl(var(--accent))/0.3] font-semibold">
            {post.data.category}
          </span>
          {post.data.featured && (
            <span class="flex items-center gap-1 px-2.5 py-1 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">
              <Sparkles className="w-3.5 h-3.5" /> Featured
            </span>
          )}
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-mono font-bold tracking-tight text-[hsl(var(--fg))] leading-tight">
          {post.data.title}
        </h1>

        <p class="text-base sm:text-lg text-[hsl(var(--fg-muted))] leading-relaxed">
          {post.data.description}
        </p>

        <!-- Metadata row -->
        <div class="flex flex-wrap items-center gap-y-3 gap-x-6 py-4 border-y border-[hsl(var(--border))] text-xs font-mono text-[hsl(var(--fg-muted))]">
          <div class="flex items-center gap-1.5">
            <User className="w-3.5 h-3.5 text-[hsl(var(--accent))]" />
            <span class="font-medium text-[hsl(var(--fg))]">{post.data.author}</span>
          </div>
          <div class="flex items-center gap-1.5">
            <Calendar className="w-3.5 h-3.5 text-[hsl(var(--accent))]" />
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          </div>
          <div class="flex items-center gap-1.5">
            <Clock className="w-3.5 h-3.5 text-[hsl(var(--accent))]" />
            <span>{post.data.readTime}</span>
          </div>
        </div>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              href={`/blog`}
              key={tag}
              class="text-xs font-mono px-2.5 py-1 rounded-md bg-[hsl(var(--bg-elevated))] text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--accent))] border border-[hsl(var(--border))] hover:border-[hsl(var(--accent))] transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </header>

      <!-- Article Content -->
      <article class="prose-article pt-6 border-t border-[hsl(var(--border))]">
        <Content />
      </article>

      <!-- Post End: Author Bio Box -->
      <div class="mt-16 pt-8 border-t border-[hsl(var(--border))] space-y-8">
        <section class="card-base p-6 sm:p-7 bg-[hsl(var(--bg-elevated))] border border-[hsl(var(--border))] flex flex-col sm:flex-row gap-5 items-start sm:items-center">
          <img
            src="/risyal.jpeg"
            alt="Risyal Febrianto"
            class="w-16 h-16 sm:w-20 sm:h-20 rounded-full object-cover border-2 border-[hsl(var(--accent))] shrink-0 shadow-md"
            loading="lazy"
            width="80"
            height="80"
          />
          <div class="space-y-2 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-mono text-base font-bold text-[hsl(var(--fg))]">
                Risyal Febrianto
              </h3>
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[hsl(var(--accent))/0.15] text-[hsl(var(--accent))] border border-[hsl(var(--accent))/0.3]">
                Software Engineer
              </span>
            </div>
            <p class="text-xs sm:text-sm text-[hsl(var(--fg-muted))] leading-relaxed">
              Full-Stack Developer & Backend Engineer yang berfokus pada arsitektur sistem performa tinggi, optimasi query database skala besar, dan modern web application berbasis Laravel, PHP, dan TypeScript.
            </p>
            <div class="flex items-center gap-4 pt-1 text-xs font-mono">
              <a
                href="https://github.com/risyalf"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--accent))] transition-colors"
              >
                GitHub ↗
              </a>
              <a
                href="https://www.linkedin.com/in/risyal-febrianto/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--accent))] transition-colors"
              >
                LinkedIn ↗
              </a>
              <a
                href="mailto:risyalfebrianto97@gmail.com"
                class="text-[hsl(var(--fg-muted))] hover:text-[hsl(var(--accent))] transition-colors"
              >
                Email ↗
              </a>
            </div>
          </div>
        </section>

        <!-- Previous & Next Article Navigation -->
        {(prevPost || nextPost) && (
          <nav aria-label="Navigasi Artikel Terkait" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevPost ? (
              <a
                href={`/blog/${prevPost.slug}`}
                class="card-base p-4 bg-[hsl(var(--bg-elevated))] hover:border-[hsl(var(--accent))] transition-colors group flex flex-col justify-between"
              >
                <div class="text-[11px] font-mono text-[hsl(var(--fg-muted))] mb-1 flex items-center gap-1">
                  <ArrowLeft className="w-3 h-3 group-hover:-translate-x-1 transition-transform text-[hsl(var(--accent))]" />
                  <span>Artikel Sebelumnya</span>
                </div>
                <div class="text-xs sm:text-sm font-mono font-medium text-[hsl(var(--fg))] group-hover:text-[hsl(var(--accent))] line-clamp-2">
                  {prevPost.data.title}
                </div>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )}

            {nextPost && (
              <a
                href={`/blog/${nextPost.slug}`}
                class="card-base p-4 bg-[hsl(var(--bg-elevated))] hover:border-[hsl(var(--accent))] transition-colors group flex flex-col justify-between text-left sm:text-right"
              >
                <div class="text-[11px] font-mono text-[hsl(var(--fg-muted))] mb-1 flex items-center gap-1 sm:justify-end">
                  <span>Artikel Selanjutnya</span>
                  <ArrowRight className="w-3 h-3 group-hover:translate-x-1 transition-transform text-[hsl(var(--accent))]" />
                </div>
                <div class="text-xs sm:text-sm font-mono font-medium text-[hsl(var(--fg))] group-hover:text-[hsl(var(--accent))] line-clamp-2">
                  {nextPost.data.title}
                </div>
              </a>
            )}
          </nav>
        )}

        <!-- Actions Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[hsl(var(--border))]">
          <a
            href="/blog"
            class="btn-secondary text-xs font-mono inline-flex items-center gap-2"
          >
            <ArrowLeft className="w-3.5 h-3.5" />
            <span>Katalog Artikel Laravel</span>
          </a>

          <button
            id="copy-link-btn"
            type="button"
            class="btn-ghost text-xs font-mono inline-flex items-center gap-2"
          >
            <Share2 className="w-3.5 h-3.5" />
            <span id="copy-text">Bagikan Artikel</span>
          </button>
        </div>
      </div>
    </div>
  </main>
  <Footer client:visible />
</Layout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-text');
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyText) {
        copyText.textContent = 'Tautan Disalin! ✓';
        setTimeout(() => {
          copyText.textContent = 'Bagikan Artikel';
        }, 2000);
      }
    } catch (e) {
      console.error(e);
    }
  });
</script>
