---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/Footer';
import BlogFeed, { type BlogPostItem } from '@/components/blog/BlogFeed';
import { getCollection } from 'astro:content';
import { Terminal, Cpu, UserCheck, BookOpen } from 'lucide-react';

const allPosts = await getCollection('blog');

// Sort by pubDate descending
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const formattedPosts: BlogPostItem[] = sortedPosts.map((post) => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }),
  category: post.data.category,
  tags: post.data.tags,
  readTime: post.data.readTime,
  author: post.data.author,
  featured: post.data.featured,
}));
---

<Layout
  title="Blog Arsitektur Laravel & Rekayasa Backend — Risyal Febrianto"
  description="Kumpulan artikel teknis, studi kasus optimasi arsitektur Laravel, antrean skala tinggi, database tuning, dan real-time systems oleh Risyal Febrianto."
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Blog', item: '/blog' },
  ]}
>
  <main class="min-h-screen pt-28 pb-20 px-4">
    <div class="max-w-4xl mx-auto space-y-12">
      <!-- Blog Hero / Header -->
      <header class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[hsl(var(--bg-elevated))] border border-[hsl(var(--border))] text-xs font-mono text-[hsl(var(--accent))]">
          <Terminal className="w-3.5 h-3.5" />
          <span>~/blog/laravel</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[hsl(var(--accent))] animate-pulse"></span>
        </div>

        <div class="space-y-3">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-mono font-bold tracking-tight text-[hsl(var(--fg))]">
            Laravel Engineering Insights
          </h1>
          <p class="text-base sm:text-lg text-[hsl(var(--fg-muted))] max-w-2xl leading-relaxed">
            Catatan arsitektur teknis, optimasi performa skala besar, sistem antrean, dan eksplorasi fitur terbaru ekosistem Laravel berdasarkan riset dan pengalaman langsung di lingkungan produksi.
          </p>
        </div>

        <!-- Telemetry / Stats Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
          <div class="card-base p-3.5 space-y-1">
            <div class="flex items-center gap-2 text-xs font-mono text-[hsl(var(--fg-muted))]">
              <Cpu className="w-3.5 h-3.5 text-[hsl(var(--accent))]" />
              <span>Spesialisasi</span>
            </div>
            <div class="text-sm font-mono font-semibold text-[hsl(var(--fg))]">
              Laravel & PHP 8.3+
            </div>
          </div>

          <div class="card-base p-3.5 space-y-1">
            <div class="flex items-center gap-2 text-xs font-mono text-[hsl(var(--fg-muted))]">
              <UserCheck className="w-3.5 h-3.5 text-[hsl(var(--accent))]" />
              <span>Penulis</span>
            </div>
            <div class="text-sm font-mono font-semibold text-emerald-400">
              Risyal Febrianto
            </div>
          </div>

          <div class="card-base p-3.5 space-y-1 col-span-2 sm:col-span-1">
            <div class="flex items-center gap-2 text-xs font-mono text-[hsl(var(--fg-muted))]">
              <BookOpen className="w-3.5 h-3.5 text-[hsl(var(--accent))]" />
              <span>Publikasi</span>
            </div>
            <div class="text-sm font-mono font-semibold text-[hsl(var(--fg))]">
              {formattedPosts.length} Studi Kasus
            </div>
          </div>
        </div>
      </header>

      <!-- Blog Interactive Feed -->
      <BlogFeed client:load posts={formattedPosts} />
    </div>
  </main>
  <Footer client:visible />
</Layout>
